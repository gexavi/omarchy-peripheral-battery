#!/usr/bin/env python3
"""Read the battery level of wireless peripherals and publish it as JSON.

Runs as a short-lived systemd oneshot (see peripheral-battery.service), once
per timer tick. It talks to the devices directly through /dev/hidraw and only
ever sends the read-only queries listed in docs/security.md. Batteries the
kernel already tracks are read from sysfs instead.

Supported:
  * Logitech HID++ 2.0 devices behind a receiver (Unifying, Lightspeed, Bolt)
    or connected directly, via features 0x1004, 0x1000 or 0x1001.
  * SteelSeries Arctis wireless headsets (Arctis 1, 7, 7+, 9, Nova 3P/5/7,
    Nova Pro Wireless), with the status requests HeadsetControl uses.
  * Any device battery the kernel exposes in /sys/class/power_supply
    (game controllers, Apple Magic devices, Logitech HID++ 1.0...).

Standard library only, no third-party dependency.
"""

import json
import os
import re
import select
import struct
import sys
import time

VERSION = "1.2.0"
DEFAULT_OUTPUT = "/run/peripheral-battery/status.json"
# Devices that stop answering (asleep, switched off) keep their last reading
# in the output, flagged offline, until they have been silent this long.
FORGET_AFTER = 12 * 3600

HID_DEVICE_DIR = re.compile(r"^[0-9A-F]{4}:[0-9A-F]{4}:[0-9A-F]{4}\.[0-9A-F]{4}$")


# --------------------------------------------------------------------------
# sysfs discovery

class HidrawNode:
    def __init__(self, name):
        self.name = name
        self.dev = "/dev/" + name
        sysdev = os.path.realpath(f"/sys/class/hidraw/{name}/device")
        uevent = _read_text(os.path.join(sysdev, "uevent"))
        hid_id = re.search(r"^HID_ID=([0-9A-F]{4}):([0-9A-F]{8}):([0-9A-F]{8})$", uevent, re.M)
        self.bus = int(hid_id.group(1), 16) if hid_id else 0
        self.vid = int(hid_id.group(2), 16) if hid_id else 0
        self.pid = int(hid_id.group(3), 16) if hid_id else 0
        self.descriptor = _read_bytes(os.path.join(sysdev, "report_descriptor"))
        parent = os.path.dirname(sysdev)
        # Nodes whose parent is itself a HID device are virtual children that
        # the kernel's logitech-dj driver creates per paired device; talking
        # to the receiver node already covers them.
        self.is_virtual_child = bool(HID_DEVICE_DIR.match(os.path.basename(parent)))
        iface = _read_text(os.path.join(parent, "bInterfaceNumber")).strip()
        self.interface = int(iface, 16) if iface else None


def _read_text(path):
    try:
        with open(path) as f:
            return f.read()
    except OSError:
        return ""


def _read_bytes(path):
    try:
        with open(path, "rb") as f:
            return f.read()
    except OSError:
        return b""


def hidraw_nodes():
    try:
        names = sorted(os.listdir("/sys/class/hidraw"), key=lambda n: int(n[6:]))
    except OSError:
        return []
    return [HidrawNode(n) for n in names if n.startswith("hidraw")]


# --------------------------------------------------------------------------
# Raw I/O

def read_matching(fd, matcher, timeout):
    """Read reports until matcher() returns non-None or the timeout expires.

    Everything that does not match is dropped on the spot. Receiver nodes also
    carry ordinary input reports (key presses, mouse motion); those are never
    decoded, stored or logged.
    """
    deadline = time.monotonic() + timeout
    while True:
        remaining = deadline - time.monotonic()
        if remaining <= 0:
            return None
        ready, _, _ = select.select([fd], [], [], remaining)
        if not ready:
            return None
        report = os.read(fd, 64)
        result = matcher(report)
        if result is not None:
            return result


# --------------------------------------------------------------------------
# Logitech HID++ 2.0

LOGITECH_VID = 0x046D
REPORT_SHORT, REPORT_LONG = 0x10, 0x11
SHORT_LEN, LONG_LEN = 7, 20
SOFTWARE_ID = 0x0B
DIRECT_DEVICE = 0xFF

FEATURE_DEVICE_NAME = 0x0005
FEATURE_BATTERY_STATUS = 0x1000
FEATURE_BATTERY_VOLTAGE = 0x1001
FEATURE_UNIFIED_BATTERY = 0x1004

# 0x0005 getDeviceType values, folded into what the bar widget displays.
DEVICE_KINDS = {0: "keyboard", 2: "keyboard", 3: "mouse", 4: "mouse", 5: "mouse", 8: "headset"}

# Li-ion discharge curve used by Solaar for feature 0x1001 (mV, %).
VOLTAGE_CURVE = [
    (4186, 100), (4067, 90), (3989, 80), (3922, 70), (3859, 60), (3811, 50),
    (3778, 40), (3751, 30), (3717, 20), (3671, 10), (3646, 5), (3579, 2), (3500, 0),
]


class HidppError(Exception):
    pass


def is_hidpp_node(node):
    d = node.descriptor
    return (node.vid == LOGITECH_VID and not node.is_virtual_child
            and b"\x06\x00\xff" in d and b"\x85\x11" in d)


class Hidpp:
    def __init__(self, fd, short_reports):
        self.fd = fd
        self.short_reports = short_reports

    def request(self, device, feature_index, function, params=b"", timeout=1.0):
        address = (function << 4) | SOFTWARE_ID
        if self.short_reports and len(params) <= SHORT_LEN - 4:
            msg = bytes([REPORT_SHORT, device, feature_index, address]) + params.ljust(SHORT_LEN - 4, b"\0")
        else:
            msg = bytes([REPORT_LONG, device, feature_index, address]) + params.ljust(LONG_LEN - 4, b"\0")
        os.write(self.fd, msg)

        def match(r):
            if len(r) < 6 or r[0] not in (REPORT_SHORT, REPORT_LONG) or r[1] != device:
                return None
            if r[2] == feature_index and r[3] == address:
                return r[4:]
            # 0xFF: HID++ 2.0 error, 0x8F: HID++ 1.0 error (e.g. no such device).
            if r[2] in (0xFF, 0x8F) and r[3] == feature_index and r[4] == address:
                raise HidppError(r[5])
            return None

        reply = read_matching(self.fd, match, timeout)
        if reply is None:
            raise HidppError("timeout")
        return reply

    def protocol(self, device):
        """Ping (root feature, function 1). Returns the major version or None.

        Empty receiver slots answer with an error right away. A device in
        power saving can miss the first ping while it wakes up, so silence
        earns one more, more patient, attempt.
        """
        for timeout in (0.4, 1.5):
            try:
                r = self.request(device, 0, 1, b"\0\0\x5a", timeout=timeout)
            except HidppError as e:
                if e.args[0] == "timeout":
                    continue
                return None
            return r[0] if r[2] == 0x5A else None
        return None

    def feature_index(self, device, feature):
        r = self.request(device, 0, 0, struct.pack(">H", feature))
        return r[0] or None

    def name(self, device):
        idx = self.feature_index(device, FEATURE_DEVICE_NAME)
        if not idx:
            return None, None
        length = self.request(device, idx, 0)[0]
        name = b""
        while len(name) < length:
            chunk = self.request(device, idx, 1, bytes([len(name)]))
            name += chunk[: length - len(name)]
        try:
            kind = DEVICE_KINDS.get(self.request(device, idx, 2)[0], "other")
        except HidppError:
            kind = "other"
        return name.decode("utf-8", "replace").strip("\0 "), kind

    def battery(self, device):
        """Returns (percent, state) with state in discharging/charging/full."""
        idx = self.feature_index(device, FEATURE_UNIFIED_BATTERY)
        if idx:
            soc, level, status, _ = self.request(device, idx, 1)[:4]
            if not soc:
                soc = {8: 100, 4: 50, 2: 20, 1: 5}.get(level, 0)
            state = {1: "charging", 2: "charging", 3: "full"}.get(status, "discharging")
            return soc, state

        idx = self.feature_index(device, FEATURE_BATTERY_STATUS)
        if idx:
            level, _, status = self.request(device, idx, 0)[:3]
            state = {1: "charging", 2: "charging", 3: "full", 4: "charging"}.get(status, "discharging")
            return level, state

        idx = self.feature_index(device, FEATURE_BATTERY_VOLTAGE)
        if idx:
            millivolt, flags = struct.unpack(">HB", self.request(device, idx, 0)[:3])
            state = "discharging"
            if flags & 0x80:
                state = "full" if flags & 0x03 == 1 else "charging"
            return voltage_to_percent(millivolt), state

        return None


def voltage_to_percent(mv):
    if mv >= VOLTAGE_CURVE[0][0]:
        return 100
    for (v_hi, p_hi), (v_lo, p_lo) in zip(VOLTAGE_CURVE, VOLTAGE_CURVE[1:]):
        if v_lo <= mv <= v_hi:
            return round(p_lo + (p_hi - p_lo) * (mv - v_lo) / (v_hi - v_lo))
    return 0


def scan_hidpp(node):
    devices = []
    with open(node.dev, "r+b", buffering=0) as f:
        hidpp = Hidpp(f.fileno(), short_reports=b"\x85\x10" in node.descriptor)
        # A receiver answers the direct address as an HID++ 1.0 device; a
        # device plugged in by cable or Bluetooth answers it as 2.0 or later.
        direct = hidpp.protocol(DIRECT_DEVICE)
        indices = [DIRECT_DEVICE] if direct and direct >= 2 else range(1, 7)
        for index in indices:
            if index != DIRECT_DEVICE:
                version = hidpp.protocol(index)
                if not version or version < 2:
                    continue  # empty slot, asleep, or legacy HID++ 1.0 device
            try:
                name, kind = hidpp.name(index)
                battery = hidpp.battery(index)
            except HidppError:
                continue
            if battery is None:
                continue
            devices.append({
                "key": f"hidpp:{node.pid:04x}:{index}:{name}",
                "name": name or "Logitech device",
                "kind": kind or "other",
                "level": battery[0],
                "state": battery[1],
            })
    return devices


# --------------------------------------------------------------------------
# SteelSeries Arctis

#
# Each dongle or base station answers one status request on one HID
# interface. The requests and reply layouts come from HeadsetControl
# (lib/devices/steelseries_*.hpp); only the Arctis 7 (2019) has been tested
# with this script. A parser returns (percent, state), or None when the
# dongle reports the headset as switched off or out of range.

STEELSERIES_VID = 0x1038


def _scale(raw, lo, hi):
    return max(0, min(100, round((raw - lo) * 100 / (hi - lo))))


def _parse_arctis_7(r):
    # Byte 2: charge in percent. With the headset switched off the dongle
    # still answers, with a level of 0. A real 0 % cannot be read either,
    # since the headset shuts down before that.
    return (r[2], "discharging") if 0 < r[2] <= 100 else None


def _parse_arctis_1(r):
    # Byte 2: 0x01 = headset off. Byte 3: charge in percent.
    return (r[3], "discharging") if r[2] != 0x01 and 0 < r[3] <= 100 else None


def _parse_arctis_9(r):
    # Byte 3: charge from 0x64 (empty) to 0x9A (full). Byte 4: 0x01 = charging.
    # This reply carries no echo of the request, so the range check also
    # rejects any unrelated report.
    if not 0x64 <= r[3] <= 0x9A:
        return None
    return _scale(r[3], 0x64, 0x9A), "charging" if r[4] == 0x01 else "discharging"


def _parse_arctis_7_plus(r):
    # Byte 1: 0x01 = headset off. Byte 2: charge, 0-4. Byte 3: 0x01 = charging.
    if r[1] == 0x01:
        return None
    return _scale(r[2], 0, 4), "charging" if r[3] == 0x01 else "discharging"


def _nova_7_parser(percent):
    # Byte 3: 0x00 = headset off, 0x01/0x02 = charging. Byte 2: charge, either
    # in steps of 0-4 or, on newer firmware (new product ids), in percent.
    def parse(r):
        if r[3] == 0x00:
            return None
        level = min(r[2], 100) if percent else _scale(r[2], 0, 4)
        return level, "charging" if r[3] in (0x01, 0x02) else "discharging"
    return parse


def _parse_nova_5(r):
    # Byte 1: 0x02 = headset off. Byte 3: charge in percent. Byte 4: 0x01 = charging.
    if r[1] == 0x02:
        return None
    return min(r[3], 100), "charging" if r[4] == 0x01 else "discharging"


def _parse_nova_pro_wireless(r):
    # Byte 15: 0x01 = headset off, 0x02 = charging by cable. Byte 6: charge, 0-8.
    if r[15] == 0x01:
        return None
    return _scale(r[6], 0, 8), "charging" if r[15] == 0x02 else "discharging"


class ArctisProtocol:
    def __init__(self, interface, request, echo, length, parse):
        self.interface = interface
        self.request = request    # bytes written to the hidraw node
        self.echo = echo          # prefix identifying the reply (b"" = none)
        self.length = length      # shortest valid reply
        self.parse = parse


ARCTIS_7 = ArctisProtocol(5, b"\x06\x18", b"\x06\x18", 3, _parse_arctis_7)
ARCTIS_1 = ArctisProtocol(3, b"\x06\x12", b"\x06\x12", 4, _parse_arctis_1)
ARCTIS_9 = ArctisProtocol(0, b"\x00\x20", b"", 5, _parse_arctis_9)
ARCTIS_7_PLUS = ArctisProtocol(3, b"\x00\xb0", b"\xb0", 4, _parse_arctis_7_plus)
NOVA_7_STEPS = ArctisProtocol(3, b"\x00\xb0", b"\xb0", 4, _nova_7_parser(percent=False))
NOVA_7_PERCENT = ArctisProtocol(3, b"\x00\xb0", b"\xb0", 4, _nova_7_parser(percent=True))
NOVA_5 = ArctisProtocol(3, b"\x00\xb0", b"\xb0", 5, _parse_nova_5)
NOVA_PRO_WIRELESS = ArctisProtocol(4, b"\x06\xb0".ljust(31, b"\0"), b"\x06\xb0", 16, _parse_nova_pro_wireless)

# product id -> (name, protocol)
ARCTIS_MODELS = {
    0x1260: ("SteelSeries Arctis 7", ARCTIS_7),
    0x12AD: ("SteelSeries Arctis 7", ARCTIS_7),
    0x12B3: ("SteelSeries Arctis 1 Wireless", ARCTIS_1),
    0x12B6: ("SteelSeries Arctis 1 Wireless", ARCTIS_1),
    0x12D5: ("SteelSeries Arctis 7P", ARCTIS_1),
    0x12D7: ("SteelSeries Arctis 7X", ARCTIS_1),
    0x12C2: ("SteelSeries Arctis 9", ARCTIS_9),
    0x12C4: ("SteelSeries Arctis 9", ARCTIS_9),
    0x220E: ("SteelSeries Arctis 7+", ARCTIS_7_PLUS),
    0x2212: ("SteelSeries Arctis 7P+", ARCTIS_7_PLUS),
    0x2216: ("SteelSeries Arctis 7X+", ARCTIS_7_PLUS),
    0x2236: ("SteelSeries Arctis 7+", ARCTIS_7_PLUS),
    0x2202: ("SteelSeries Arctis Nova 7", NOVA_7_STEPS),
    0x2206: ("SteelSeries Arctis Nova 7X", NOVA_7_STEPS),
    0x220A: ("SteelSeries Arctis Nova 7P", NOVA_7_STEPS),
    0x223A: ("SteelSeries Arctis Nova 7", NOVA_7_STEPS),
    0x227A: ("SteelSeries Arctis Nova 7", NOVA_7_STEPS),
    0x22A4: ("SteelSeries Arctis Nova 7X", NOVA_7_STEPS),
    0x22A1: ("SteelSeries Arctis Nova 7", NOVA_7_PERCENT),
    0x227E: ("SteelSeries Arctis Nova 7 Gen 2", NOVA_7_PERCENT),
    0x2258: ("SteelSeries Arctis Nova 7X", NOVA_7_PERCENT),
    0x229E: ("SteelSeries Arctis Nova 7X", NOVA_7_PERCENT),
    0x22AD: ("SteelSeries Arctis Nova 7X", NOVA_7_PERCENT),
    0x22A5: ("SteelSeries Arctis Nova 7X", NOVA_7_PERCENT),
    0x22A9: ("SteelSeries Arctis Nova 7", NOVA_7_PERCENT),
    0x22A7: ("SteelSeries Arctis Nova 7P", NOVA_7_PERCENT),
    0x2298: ("SteelSeries Arctis Nova 7P", NOVA_7_PERCENT),
    0x2232: ("SteelSeries Arctis Nova 5", NOVA_5),
    0x2253: ("SteelSeries Arctis Nova 5X", NOVA_5),
    0x2269: ("SteelSeries Arctis Nova 3P Wireless", NOVA_5),
    0x226D: ("SteelSeries Arctis Nova 3X Wireless", NOVA_5),
    0x12E0: ("SteelSeries Arctis Nova Pro Wireless", NOVA_PRO_WIRELESS),
    0x12E5: ("SteelSeries Arctis Nova Pro Wireless", NOVA_PRO_WIRELESS),
}


def is_arctis_node(node):
    model = ARCTIS_MODELS.get(node.pid) if node.vid == STEELSERIES_VID else None
    return model is not None and node.interface == model[1].interface


def is_arctis_reply(protocol, report):
    return len(report) >= protocol.length and report.startswith(protocol.echo)


def scan_arctis(node):
    name, protocol = ARCTIS_MODELS[node.pid]
    with open(node.dev, "r+b", buffering=0) as f:
        fd = f.fileno()
        os.write(fd, protocol.request)
        reply = read_matching(fd, lambda r: r if is_arctis_reply(protocol, r) else None, 1.0)
    reading = protocol.parse(reply) if reply is not None else None
    if reading is None:
        return []
    return [{
        "key": f"arctis:{node.pid:04x}",
        "name": name,
        "kind": "headset",
        "level": reading[0],
        "state": reading[1],
    }]


# --------------------------------------------------------------------------
# Batteries the kernel already exposes
#
# Several kernel drivers publish a device battery under
# /sys/class/power_supply: game controllers (playstation, xpadneo, nintendo,
# wiimote, steam), Apple Magic devices, HID devices that report a battery
# strength, and Logitech devices through hid-logitech-hidpp (which also
# covers the HID++ 1.0 devices the reader above skips). Reading them needs
# no request to the device: the values are read-only sysfs attributes.

POWER_SUPPLY_DIR = "/sys/class/power_supply"
CAPACITY_LEVELS = {"Full": 100, "High": 80, "Normal": 50, "Low": 20, "Critical": 5}
DRIVER_KINDS = {
    "playstation": "gamepad", "sony": "gamepad", "xpadneo": "gamepad",
    "nintendo": "gamepad", "wiimote": "gamepad", "steam": "gamepad",
    "magicmouse": "mouse", "apple": "keyboard",
}
NAME_KINDS = [
    (re.compile(r"controller|gamepad|joy-?con|dualsense|dualshock|xbox", re.I), "gamepad"),
    (re.compile(r"mouse|trackpad|trackball", re.I), "mouse"),
    (re.compile(r"keyboard", re.I), "keyboard"),
    (re.compile(r"headset|headphone|buds", re.I), "headset"),
]


def _uevent(path, prefix=""):
    props = {}
    for line in _read_text(path).splitlines():
        key, sep, value = line.partition("=")
        if sep and key.startswith(prefix):
            props[key[len(prefix):]] = value
    return props


def device_kind(name, driver):
    if driver in DRIVER_KINDS:
        return DRIVER_KINDS[driver]
    for pattern, kind in NAME_KINDS:
        if pattern.search(name):
            return kind
    return "other"


def scan_kernel(skip_names):
    """Device batteries from sysfs, except those named in skip_names."""
    try:
        entries = sorted(os.listdir(POWER_SUPPLY_DIR))
    except OSError:
        return []
    devices = []
    for entry in entries:
        base = os.path.join(POWER_SUPPLY_DIR, entry)
        props = _uevent(os.path.join(base, "uevent"), "POWER_SUPPLY_")
        # SCOPE=Device: a peripheral's battery, not the laptop's own.
        if props.get("TYPE") != "Battery" or props.get("SCOPE") != "Device" or props.get("PRESENT") == "0":
            continue
        status = props.get("STATUS", "Unknown")
        if props.get("CAPACITY", "").isdigit():
            level = min(int(props["CAPACITY"]), 100)
        elif props.get("CAPACITY_LEVEL") in CAPACITY_LEVELS:
            level = CAPACITY_LEVELS[props["CAPACITY_LEVEL"]]
        else:
            continue
        # A HID battery the device has not reported yet reads 0 % with an
        # unknown status.
        if level == 0 and status == "Unknown":
            continue
        parent = os.path.realpath(os.path.join(base, "device"))
        hid = _uevent(os.path.join(parent, "uevent"))
        name = (props.get("MODEL_NAME") or hid.get("HID_NAME") or entry).strip()
        if name in skip_names:
            continue  # already read directly, with more detail
        driver = os.path.basename(os.path.realpath(os.path.join(parent, "driver")))
        serial = props.get("SERIAL_NUMBER") or hid.get("HID_UNIQ") or ""
        devices.append({
            "key": f"kernel:{name}:{serial}" if serial else f"kernel:{name}",
            "name": name,
            "kind": device_kind(name, driver),
            "level": level,
            "state": {"Charging": "charging", "Full": "full"}.get(status, "discharging"),
        })
    return devices


# --------------------------------------------------------------------------

def scan(previous=()):
    found = []
    for node in hidraw_nodes():
        try:
            if is_hidpp_node(node):
                found += scan_hidpp(node)
            elif is_arctis_node(node):
                found += scan_arctis(node)
        except OSError as e:
            print(f"{node.dev}: {e}", file=sys.stderr)
    # The kernel also lists most Logitech devices read above. Skip them, and
    # those read directly before, so that a sleeping mouse is not shown twice.
    direct = {d["name"] for d in list(found) + list(previous)
              if not str(d.get("key", "")).startswith("kernel:")}
    return found + scan_kernel(direct)


KIND_ORDER = ["mouse", "keyboard", "headset", "gamepad"]


def merge(previous, found, now):
    """Keep the last reading of devices that stopped answering."""
    current = {d["key"]: dict(d, online=True, seen=now) for d in found}
    for d in previous:
        key = d.get("key")
        if key and key not in current and now - d.get("seen", 0) < FORGET_AFTER:
            current[key] = dict(d, online=False)
    return sorted(current.values(), key=lambda d: (KIND_ORDER + [d["kind"]]).index(d["kind"]))


def main():
    output = sys.argv[1] if len(sys.argv) > 1 else DEFAULT_OUTPUT
    try:
        with open(output) as f:
            previous = json.load(f).get("devices", [])
    except (OSError, ValueError):
        previous = []

    now = int(time.time())
    status = {"version": VERSION, "updated": now, "devices": merge(previous, scan(previous), now)}

    tmp = output + ".tmp"
    with open(tmp, "w") as f:
        json.dump(status, f, indent=2)
    os.chmod(tmp, 0o644)
    os.replace(tmp, output)


if __name__ == "__main__":
    main()
